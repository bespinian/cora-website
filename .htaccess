# Apache config for the Infomaniak web host. The site is static files pushed
# over FTP by .github/workflows/deploy.yml, so this file is the only place a
# response status, a redirect or a cache lifetime can be set at all.

# --- The custom 404 ------------------------------------------------------
# Without this line Apache answers every missing path with its own stock
# "Not Found" page and 404.html is never served. 404.html is built with
# root-absolute URLs throughout precisely so it renders correctly no matter
# which path - /nope.html, /en/nope.html, /fr/nope.html - was requested.
ErrorDocument 404 /404.html

# --- No directory listings -----------------------------------------------
# /assets/img/ was serving a browsable index of every file in it.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- One host, one protocol ------------------------------------------
  # Four spellings of every URL were answering 200: http and https, apex and
  # www. The canonical tags keep that out of the index, but the crawl and any
  # inbound links still split four ways. These two rules collapse them.
  #
  # TLS is terminated upstream, so Apache sees a plain HTTP request on port 80
  # even when the visitor asked for https - %{HTTPS} is off and %{SERVER_PORT}
  # is 80 for everything. The proxy's X-Forwarded-Proto is the only honest
  # signal here, and the test below is deliberately positive (= http rather
  # than != https): if that header ever stops being sent the rule does nothing,
  # instead of redirecting https:// to itself forever and taking the site down.
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^ https://keera.ch%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.keera\.ch$ [NC]
  RewriteRule ^ https://keera.ch%{REQUEST_URI} [R=301,L]
</IfModule>

# --- Cache lifetimes -----------------------------------------------------
# Nothing was sending Cache-Control or Expires, so every repeat visit
# revalidated the fonts and the artwork - one round trip per file, on a host
# that only speaks HTTP/1.1. This was a mod_expires block until a check against
# production showed it emitting no headers at all: Infomaniak does not load
# mod_expires, so the <IfModule> guard skipped the whole thing silently.
# mod_headers is loaded, and matches on filename rather than MIME type.
<IfModule mod_headers.c>
  # A year, and immutable, because deploy stamps every asset URL with
  # ?v=<content hash> (.github/scripts/fingerprint-assets.py). A query string
  # is part of the cache key, so replacing an illustration in place under the
  # name it already has changes the URL the pages ask for and the old bytes are
  # simply never requested again. Without that step this would have to drop
  # back to a month: nothing in assets/ carries a hash in its filename.
  <FilesMatch "\.(webp|jpe?g|png|svg|woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Pages carry the stamps, so they are the one thing that must stay fresh -
  # cache a page and the reader goes on asking for the assets it named when it
  # was cached. no-cache still allows a cheap ETag revalidation, it only
  # forbids serving a stale copy without asking.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # robots.txt and sitemap.xml
  <FilesMatch "\.(txt|xml)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
